{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "terms_verified",
 "type": "object",
 "required": [
  "terms"
 ],
 "properties": {
  "terms": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "manuscript_term",
     "standard_term",
     "check"
    ],
    "properties": {
     "manuscript_term": {
      "type": "string"
     },
     "standard_term": {
      "type": "string"
     },
     "check": {
      "type": "string",
      "enum": [
       "verified",
       "unverified",
       "wrong"
      ]
     },
     "corrected_term": {
      "type": "string"
     },
     "source_key": {
      "type": "string"
     },
     "locator": {
      "type": "string"
     },
     "note": {
      "type": "string"
     }
    }
   }
  }
 }
}